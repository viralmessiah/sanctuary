# Copy to .env and edit. Never commit the real .env.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

FRONTEND_URL=http://localhost:5173
# Only set when the API is on a different origin than the frontend (e.g. https://api.example.com)
PUBLIC_BASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database: sqlite (default) or postgres
DB_ENGINE=sqlite
# DB_NAME=sanctuary
# DB_USER=sanctuary
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Email (DEBUG=True prints emails to the console by default)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Sanctuary AgriConnect <no-reply@example.com>

# Google sign-in (optional). Redirect URI to register: <API origin>/api/auth/google/callback/
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
